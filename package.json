    "zustand": "~5.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_ui.git"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
