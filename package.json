{
  "name": "@sudobility/music_ui",
  "version": "0.0.5",
  "description": "Shared functional UI for ScoreSmith's web app (editor shell, toolbar, transport, inspector, score view, keyboard, spatial, print) — routing and content pages stay in the app",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/music_ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && vite build && node scripts/fix-esm-imports.mjs",
    "dev": "vite build --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "scoresmith",
    "moosiac",
    "music",
    "web",
    "ui",
    "tailwindcss",
    "editor"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@heroicons/react": ">=2",
    "@sudobility/components": "^5.3.67",
    "@sudobility/design": "^1.1.71",
    "@sudobility/music_client": "^0.4.108",
    "@sudobility/music_codecs": "^0.2.67",
    "@sudobility/music_drawing": "^0.0.78",
    "@sudobility/music_editing": "^0.0.66",
    "@sudobility/music_io": "^0.9.85",
    "@sudobility/music_lib": "^1.9.89",
    "@sudobility/music_player": "^0.1.86",
    "@sudobility/music_spatial": "^0.0.37",
    "@sudobility/music_types": "^0.13.66",
    "@sudobility/printing": "^0.1.0",
    "@sudobility/printing_core": "^0.1.0",
    "@sudobility/routing": "^0.0.3",
    "@tanstack/react-query": ">=5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "i18next": ">=23",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-i18next": ">=14",
    "tailwind-merge": ">=2.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@heroicons/react": "~2.2.0",
    "@react-three/fiber": "~9.8.2",
    "@sudobility/components": "^5.3.67",
    "@sudobility/design": "^1.1.71",
    "@sudobility/music_client": "^0.4.108",
    "@sudobility/music_codecs": "^0.2.67",
    "@sudobility/music_drawing": "^0.0.78",
    "@sudobility/music_editing": "^0.0.66",
    "@sudobility/music_io": "^0.9.85",
    "@sudobility/music_lib": "^1.9.89",
    "@sudobility/music_player": "^0.1.86",
    "@sudobility/music_spatial": "^0.0.37",
    "@sudobility/music_spatial_core": "^0.0.33",
    "@sudobility/music_types": "^0.13.66",
    "@sudobility/printing": "^0.1.0",
    "@sudobility/printing_core": "^0.1.0",
    "@sudobility/routing": "^0.0.3",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitejs/plugin-react": "~5.1.2",
    "@vitest/coverage-v8": "~4.1.12",
    "ajv": "~8.20.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "i18next": "~26.3.1",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~17.0.8",
    "rimraf": "~6.1.3",
